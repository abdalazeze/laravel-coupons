{
    "name": "abdalazeze/laravel-coupons",
    "description": "Concurrency-safe coupons, discounts, and cashback engine for Laravel",
    "keywords": ["laravel", "coupons", "discounts", "promotions"],
    "homepage": "https://github.com/abdalazeze/laravel-coupons",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Abdulaziz Nour Eddin",
            "email": "abd.alazeze@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.71|^13.40",
        "illuminate/database": "^12.71|^13.40",
        "illuminate/support": "^12.71|^13.40"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Abdalazeze\\Coupons\\": "src/",
            "Abdalazeze\\Coupons\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Abdalazeze\\Coupons\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abdalazeze\\Coupons\\CouponsServiceProvider"
            ],
            "aliases": {
                "Coupons": "Abdalazeze\\Coupons\\Facades\\Coupons"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=512M"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
